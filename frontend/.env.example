# OrgCred frontend — exemplo de configuração
# Copie este arquivo para .env.local e preencha com os valores reais.
# Nunca commitar .env.local (já está no .gitignore).

# URL base da API (default: backend local via docker compose)
VITE_API_BASE_URL=http://localhost:8000

# Autenticação Supabase — projeto ainda não provisionado neste repositório.
# Sem esses valores, a integração de login (Fase F1) fica sem efeito real:
# o SDK carrega mas nenhuma chamada de auth terá para onde ir.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
