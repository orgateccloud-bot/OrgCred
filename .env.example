# OrgCred — Exemplo de configuração
# Copie este arquivo para .env e preencha com suas credenciais

# Banco de dados
# Desenvolvimento local:
ORGCRED_DATABASE_URL=postgresql://postgres:password@localhost:5432/orgcred_dev

# Ambiente
ORGCRED_ENVIRONMENT=development
ORGCRED_DEBUG=true

# Autenticação Supabase
# O prefixo ORGCRED_ é obrigatório: é o env_prefix de app/core/config.py.
# Sem ele a variável é ignorada e a aplicação cai no default de
# desenvolvimento — em produção o startup recusa iniciar nesse caso.
# Em desenvolvimento, usar uma secret comum (NÃO em produção!)
# Em produção, usar a JWT Secret real da sua instância Supabase
ORGCRED_SUPABASE_JWT_SECRET=dev-secret-key-change-in-prod

# Storage dos documentos de identificação (Supabase Storage)
#
# ATENÇÃO — SÃO TRÊS COISAS DIFERENTES no painel do Supabase, e trocá-las
# entre si NÃO dá erro de configuração: dá 401 do bucket na hora de arquivar
# um documento, com a aplicação inteira funcionando.
#
#   1. JWT Secret (ORGCRED_SUPABASE_JWT_SECRET, acima) — segredo de
#      ASSINATURA, usado para VALIDAR os tokens que o frontend manda.
#      Settings > API > JWT Settings.
#   2. anon key — chave PÚBLICA, vai assada no bundle do frontend
#      (VITE_SUPABASE_ANON_KEY, build arg do Dockerfile). Quem protege os
#      dados por trás dela é a RLS. NÃO É ESTA que vai abaixo.
#   3. service_role key (ORGCRED_SUPABASE_SERVICE_KEY, abaixo) — chave de
#      SERVIDOR, ATRAVESSA RLS. Settings > API > Project API keys, a que vem
#      marcada como "secret". É a única das três que grava no bucket, e a
#      única que NUNCA pode ir para o frontend, para log ou para mensagem de
#      erro.
#
# SEM DEFAULT DE PROPÓSITO. Vazias, o startup sobe normalmente (o OrgCred
# opera sem compliance ativo) mas ARQUIVAR DOCUMENTO É RECUSADO com 503 —
# fail-closed. Aceitar o hash sem guardar o arquivo é o defeito que a
# migration 019 corrigiu: o sistema afirmando que a identificação exigida
# pela Lei 9.613/98 (art. 10, I) está arquivada, sem nada arquivado.
ORGCRED_SUPABASE_URL=https://seu-projeto.supabase.co
ORGCRED_SUPABASE_SERVICE_KEY=

# Bucket onde os documentos ficam. Tem default no código
# ("identificacao-tomador") porque é NOME, não credencial — errá-lo dá 404
# explícito na primeira gravação, não falha silenciosa. Crie-o como PRIVADO:
# documento de identificação de tomador em bucket público é vazamento de PII.
# ORGCRED_SUPABASE_STORAGE_BUCKET=identificacao-tomador

# Produção (descomente e configure):
# ORGCRED_ENVIRONMENT=production
# ORGCRED_DATABASE_URL=postgresql://user:password@prod-db.example.com:5432/orgcred_prod
# ORGCRED_SUPABASE_JWT_SECRET=sua-secret-real-do-supabase
# ORGCRED_SUPABASE_URL=https://seu-projeto.supabase.co
# ORGCRED_SUPABASE_SERVICE_KEY=sua-service-role-key-do-supabase
